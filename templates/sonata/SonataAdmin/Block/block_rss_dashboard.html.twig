{#
    RSS feed on the dashboard: a card with the items as a list.
#}
{% extends '@SonataBlock/Block/block_core_rss.html.twig' %}

{% block block %}
    <div class="card card-outline card-warning mb-3">
        <div class="card-header">
            <h3 class="card-title sonata-feed-title"><i class="fas fa-rss" aria-hidden="true"></i> {{ settings.title }}</h3>
        </div>
        <div class="sonata-feeds-container list-group list-group-flush">
            {% for feed in feeds %}
                <a class="list-group-item list-group-item-action" href="{{ feed.link }}" rel="nofollow" title="{{ feed.title }}">
                    <strong>{{ feed.title }}</strong>
                    <div class="small text-body-secondary">{{ feed.description|raw }}</div>
                </a>
            {% else %}
                <div class="list-group-item text-body-secondary">No feeds available.</div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
