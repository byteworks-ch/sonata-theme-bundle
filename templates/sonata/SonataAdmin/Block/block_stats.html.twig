{#
    Statistic of an admin on the dashboard: AdminLTE's small box. The color may be an AdminLTE 2 class ("bg-aqua"
    becomes info), the icon gets the class of AdminLTE's box icon.
#}
{% extends sonata_block.templates.block_base %}

{% set translation_domain = settings.translation_domain ?? admin.translationDomain %}

{% block block %}
    {% set _color = settings.color|adminlte4_color %}
    {% set _link = _color in ['warning', 'info', 'light'] ? 'link-dark' : 'link-light' %}
    <div class="small-box text-bg-{{ _color }}">
        <div class="inner">
            <h3>{{ pager.countResults() }}</h3>
            <p>
                {% if translation_domain %}
                    {{ settings.text|trans({'%count%': pager.countResults()}, translation_domain) }}
                {% else %}
                    {{ settings.text }}
                {% endif %}
            </p>
        </div>
        {% if settings.icon starts with '<' %}
            <span class="small-box-icon" aria-hidden="true">{{ settings.icon|raw }}</span>
        {% elseif settings.icon %}
            {{ (settings.icon ~ ' small-box-icon')|parse_icon }}
        {% endif %}
        <a href="{{ admin.generateUrl('list', {filter: settings.filters}) }}" class="small-box-footer {{ _link }} link-underline-opacity-0 link-underline-opacity-50-hover">
            {{ 'stats_view_more'|trans({}, 'SonataAdminBundle') }} <i class="fas fa-arrow-circle-right" aria-hidden="true"></i>
        </a>
    </div>
{% endblock %}
