{#
    Base template of XHR requests, e.g. a list or a form in the modal of an association field: the page content
    without the layout around it; for lists the toolbar (filter selection, list modes), the filters and the table.
#}
{% block content %}
    {% set _list_table = block('list_table') is defined ? block('list_table')|trim : null %}
    {% set _list_filters = block('list_filters') is defined ? block('list_filters')|trim : null %}
    {% set _list_filters_actions = block('list_filters_actions') is defined ? block('list_filters_actions')|trim : null %}

    {% block preview %}{% endblock %}
    {% block form %}{% endblock %}
    {% block list %}{% endblock %}
    {% block show %}{% endblock %}

    {% if _list_table is not empty or _list_filters is not empty %}
        <div class="sonata-list-table">
            {% set _has_list_modes = admin is defined and action is defined and action == 'list' and admin.listModes|length > 1 %}
            {% if _list_filters_actions is not empty or _has_list_modes %}
                <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mb-2">
                    {% if _list_filters_actions is not empty %}
                        {{ _list_filters_actions|raw }}
                    {% endif %}
                    {% if _has_list_modes %}
                        <div class="btn-group btn-group-sm" role="group">
                            {% for mode, settings in admin.listModes %}
                                <a href="{{ admin.generateUrl('list', app.request.query.all|merge({_list_mode: mode})) }}" class="btn btn-outline-secondary{% if admin.getListMode() == mode %} active{% endif %}">
                                    {% if settings.icon is not defined and settings.class is defined %}
                                        <i class="{{ settings.class }}" aria-hidden="true"></i>
                                    {% else %}
                                        {{ settings.icon|default('')|parse_icon }}
                                    {% endif %}
                                </a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            {% endif %}
            {% if _list_filters|trim %}
                <div class="row">
                    {{ _list_filters|raw }}
                </div>
            {% endif %}
            <div class="row">
                {{ _list_table|raw }}
            </div>
        </div>
    {% endif %}
{% endblock %}
