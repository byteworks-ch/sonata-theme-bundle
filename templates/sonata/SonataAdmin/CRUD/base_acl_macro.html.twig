{#
    Form of the access control list (ACL) of an object: a row per role or user, a checkbox per permission. The header
    row repeats every ten rows, as in Sonata. The form gets the admin's form theme (Sonata renders it with the default
    one), so the checkboxes look like all others.
#}
{% macro render_form(form, permissions, td_type, admin, admin_configuration, object) %}
    {% form_theme form with admin.getFormTheme() %}
    <form action="{{ admin.generateUrl('acl', {(admin.idParameter): admin.id(object), 'uniqid': admin.uniqid, 'subclass': app.request.attributes.get('subclass', app.request.query.get('subclass', app.request.request.get('subclass')))}) }}"
          {% if form.vars.multipart %} enctype="multipart/form-data"{% endif %}
          method="POST"
          {% if not admin_configuration.getOption('html5_validate') %}novalidate="novalidate"{% endif %}>
        {{ include('@SonataAdmin/Helper/render_form_dismissable_errors.html.twig') }}
        <div class="card card-outline card-success mb-3">
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover align-middle mb-0 adminlte4-acl-table">
                    {% for child in form.children|filter(child => child.vars.name != '_token') %}
                        {% if loop.index0 % 10 == 0 %}
                            <tr>
                                <th scope="col">{{ td_type|trans({}, 'SonataAdminBundle') }}</th>
                                {% for permission in permissions %}
                                    <th scope="col" class="text-center">{{ permission }}</th>
                                {% endfor %}
                            </tr>
                        {% endif %}
                        <tr>
                            <td>
                                {% set typeChild = child['role'] is defined ? child['role'] : child['user'] %}
                                {{ typeChild.vars.value }}
                                {{ form_widget(typeChild) }}
                            </td>
                            {% for permission in permissions %}
                                <td class="text-center">{{ form_widget(child[permission], {label: false, attr: {'aria-label': typeChild.vars.value ~ ': ' ~ permission}}) }}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </table>
            </div>
            <div class="card-footer">
                {{ form_row(form._token) }}
                <input class="btn btn-primary" type="submit" name="btn_create_and_edit" value="{{ 'btn_update_acl'|trans({}, 'SonataAdminBundle') }}">
            </div>
        </div>
    </form>
{% endmacro %}
