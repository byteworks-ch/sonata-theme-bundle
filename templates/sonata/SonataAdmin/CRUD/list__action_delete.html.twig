{#- icon only: no white space next to the icon, so it sits in the middle of the button -#}
{% if admin.hasAccess('delete', object) and admin.hasRoute('delete') %}
    {%- set button_content = sonata_config.getOption('list_action_button_content') -%}
    {%- set label = 'action_delete'|trans({}, 'SonataAdminBundle') -%}
    <a href="{{ admin.generateObjectUrl('delete', object, actions.link_parameters|default([])) }}" class="btn btn-sm btn-outline-secondary delete_link" title="{{ label }}">
        {%- if button_content == 'icon' or button_content == 'all' -%}
            <i class="fas fa-times" aria-hidden="true"></i>
        {%- endif -%}
        {%- if button_content == 'all' %} {% endif -%}
        {%- if button_content == 'text' or button_content == 'all' -%}
            {{ label }}
        {%- else -%}
            <span class="visually-hidden">{{ label }}</span>
        {%- endif -%}
    </a>
{%- endif %}
