{% for error in form.vars.errors %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        {{ error.message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'message_close'|trans({}, 'SonataTwigBundle') }}"></button>
    </div>
{% endfor %}
